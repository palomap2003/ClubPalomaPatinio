# Copiar a ".env" y completar. El archivo ".env" NO se sube a GitHub.

# Conexión a PostgreSQL (en Render: "Internal Database URL" o "External" si corrés en tu PC)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/club

# Credenciales de la cuenta de servicio de Firebase (Project settings > Service accounts > Generate new private key).
# Opción A (recomendada en Render): pegar el contenido COMPLETO del JSON en una sola línea.
FIREBASE_CREDENTIALS_JSON=
# Opción B (desarrollo local): ruta al archivo JSON descargado.
GOOGLE_APPLICATION_CREDENTIALS=

# Clave secreta para que el Cron Job de Render pueda disparar los recordatorios push.
CRON_SECRET=cambiar-por-un-valor-largo-y-aleatorio
